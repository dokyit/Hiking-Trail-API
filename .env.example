# API Keys
GOOGLE_MAPS_KEY=your_google_maps_api_key_here
WEATHERSTACK_KEY=your_weatherstack_api_key_here

# Database (for local development)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hiking_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hiking_db
DB_USER=postgres
DB_PASSWORD=your_password

# Redis (for local development)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Flask Configuration
SECRET_KEY=your-local-secret-key-change-this
JWT_SECRET_KEY=your-local-jwt-secret-change-this
FLASK_ENV=development

# Instructions:
# 1. Copy this file to .env (do NOT commit .env to git!)
# 2. Replace all placeholder values with your actual credentials
# 3. Get Google Maps API key from: https://console.cloud.google.com/
# 4. Get WeatherStack API key from: https://weatherstack.com/
